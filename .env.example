# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# STRIPE EMBEDDED CHECKOUT (SERVER-SIDE ONLY)
# ==============================================================================
# Stripe Publishable Key: Safe for frontend configuration (pk_test_... for test, pk_live_... for live)
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# Stripe Secret Key: NEVER expose to client or git (sk_test_... for test, sk_live_... for live)
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"

# Stripe Webhook Secret: Used to cryptographically verify signature at /api/webhook/stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret_here"

# ==============================================================================
# DURABLE TRANSACTIONAL STORAGE (REQUIRED FOR CLOUD RUN PRODUCTION)
# ==============================================================================
# PostgreSQL Connection URL (e.g. postgresql://user:password@host:5432/dbname)
# Required in production because container filesystems are ephemeral.
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# ==============================================================================
# SHOPIFY ORDER BRIDGE (SERVER-SIDE ONLY)
# ==============================================================================
# Shopify Store Domain: e.g. 6u0kc1-nm.myshopify.com
SHOPIFY_STORE_DOMAIN="6u0kc1-nm.myshopify.com"

# Shopify Custom App Admin API Access Token (with 'write_orders' scope)
# Used exclusively server-side to import paid orders into Shopify
SHOPIFY_ADMIN_API_TOKEN="shpat_your_admin_access_token_here"

# ==============================================================================
# OPERATIONAL SECURITY
# ==============================================================================
# Secret Token for Operator Endpoints (/api/checkout/operator-status)
# MUST NOT be exposed in frontend
OPERATOR_AUTH_TOKEN="sec_operator_token_min_32_chars_here"

# Fallback Flag: Allows manual fallback button if needed (default: false)
ENABLE_SHOPIFY_FALLBACK="false"
